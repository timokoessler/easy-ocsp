{
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules/", "dist"],
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "target": "ES2022",
        "moduleResolution": "bundler",
        "outDir": "dist",
        "rootDir": ".",
        "declaration": true,
        "esModuleInterop": true,
        "strict": true,
        "allowJs": false,
        "resolveJsonModule": true,
        "inlineSourceMap": false,
        "skipLibCheck": true
    }
}
